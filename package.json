{
  "name": "@stanzaapi/iban-validator",
  "version": "1.0.0",
  "description": "Official zero-dependency, high-speed JavaScript/TypeScript client for Global IBAN, BIC/SWIFT & Bank Routing Validator API",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "keywords": [
    "iban",
    "bic-swift",
    "sepa",
    "iso-13616",
    "mod-97",
    "bban",
    "bank-routing",
    "fintech",
    "payment-validation"
  ],
  "author": "Stanza",
  "license": "MIT",
  "homepage": "https://stanzaapi.com/tools/iban-validator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StanzaAPI/iban-validator-typescript.git"
  }
}